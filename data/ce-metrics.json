  "metricDefs": [
    {
      "id": "drillCompletionRate",
      "name": "Drill Completion Rate",
      "formula": "drills_done / drills_expected_in_period",
      "target": 1,
      "notes": "Org and team: sum agent drillsDoneInPeriod over team drillsExpectedInPeriod (or org sum of team expectations)."
    },
    {
      "id": "writeBackRate",
      "name": "Write-Back Rate",
      "formula": "writebacks / drills_done (N/A if drills_done = 0)",
      "target": 1,
      "notes": "Target 100%. Every completed drill should produce a write-back."
    },
    {
      "id": "staleDays",
      "name": "Stale Days",
      "formula": "days since lastWriteBackAt",
      "target": "Medical green \u22648; biweekly green \u226414; yellow = green+7; else red; null/gray if never",
      "notes": "Color chips: green / yellow / red / gray."
    },
    {
      "id": "skillsPromoted",
      "name": "Skills Promoted",
      "formula": "sum skillsPromotedCount",
      "target": null,
      "notes": "Cumulative promotions in the current reporting window."
    },
    {
      "id": "primarySourceRigor",
      "name": "Primary Source Rigor",
      "formula": "primarySourceCitedCount / writeBacks",
      "target": 1,
      "notes": "Per agent or team. N/A if writeBacks = 0."
    },
    {
      "id": "capabilityScore",
      "name": "Capability Score",
      "formula": "rubric 1\u20135 from JSON (not computed)",
      "target": null,
      "notes": "1 Emerging \u00b7 2 Developing \u00b7 3 Competent \u00b7 4 Proficient \u00b7 5 Expert"
    }
  ],
